
---
import "./src/styles/global.css"


const {title = "Impermeablizaciones Luis"}
= 

Astro.props
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/jpg" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title> {title}</title>
		<link rel="stylesheet" href="/src/styles/global.css" />
	</head>
	<body>
		<!-- Header -->
		<header class="header">
			<div class="container">
				<div class="logo">
					<img src="/src/assets/logo.PNG" alt="ImperTech Logo">
					<span>Impermeablizaciones D$L</span>
					<p>Expertos en Impermeabilización</p>
				</div>
				<nav class="main-nav">
					<ul>
						<li><a href="#inicio">INICIO</a></li>
						<li><a href="#servicios">SERVICIOS</a></li>
						<li><a href="#proyectos">PROYECTOS</a></li>
						<li><a href="#quienes-somos">QUIÉNES SOMOS</a></li>
						<li><a href="#materiales">MATERIALES</a></li>
						<li><a href="#contacto">CONTACTO</a></li>
					</ul>
				</nav>
				<div class="social-icons">
					<a href="#" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
					<a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
					<a href="#" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
				</div>
			</div>
		</header>
	
		<!-- Hero Section -->
		<section class="hero">
			<div class="hero-content" >
				
				<h1>IMPERMEABILIZACIÓN DE CUBIERTAS</h1>
				<p>Somos una empresa con más de 20 años de experiencia dedicada a ofrecer soluciones profesionales de impermeabilización en toda la región.</p>
				<div class="contact-numbers">
					<span>321-294-2258</span>
					<span>-</span>
					<span>320-878-1905</span>
				</div>
				<a href="#contacto" class="contact-button">CONTACTO</a>
			</div>
		</section>
	
		<!-- Services Navigation -->
		<section class="services-nav">
			<div class="container">
				<a href="#terrazas" class="service-link">TERRAZAS Y TECHOS</a>
				<a href="#cubiertas" class="service-link">CUBIERTAS</a>
				<a href="#fachadas" class="service-link">FACHADAS</a>
				<a href="#tanques" class="service-link">TANQUES DE AGUA</a>
			</div>
		</section>
	
		<!-- About Section -->
		<section class="about" id="quienes-somos">
			<div class="container">
				<h2>SOMOS ESPECIALISTAS EN LA INSTALACIÓN DE SISTEMAS DE IMPERMEABILIZACIÓN Y CUBIERTAS</h2>
				<div class="about-content">
					<div class="about-text">
						<p>Ofrecemos soluciones profesionales y expertas para brindarle una solución a problemas de humedad, fugas de agua y goteras en:</p>
						<ul>
							<li>Terrazas y cubiertas</li>
							<li>Canales y canaletas</li>
							<li>Tanques de reserva de agua</li>
							<li>Fachadas de casas y edificios</li>
							<li>Servicio de pintura de fachadas</li>
						</ul>
						<p>Brindamos atención inmediata en toda la región y sus alrededores.</p>
					</div>
					<div class="about-image">
						<img src="/src/assets/background.jpg" alt="Instalador experto">
					</div>
				</div>
			</div>
		</section>
	
		<!-- Services Section -->
		<section class="services" id="servicios">
			<div class="container">
				<h2>NUESTROS SERVICIOS</h2>
				<div class="services-grid">
					<div class="service-card">
						<img src="/images/terraza.jpg" alt="Impermeabilización de terrazas">
						<h3>Impermeabilización de Terrazas</h3>
						<p>Protegemos sus terrazas contra filtraciones y humedad con las mejores técnicas.</p>
					</div>
					<div class="service-card">
						<img src="/images/cubierta.jpg" alt="Impermeabilización de cubiertas">
						<h3>Impermeabilización de Cubiertas</h3>
						<p>Instalamos sistemas de impermeabilización para todo tipo de cubiertas.</p>
					</div>
					<div class="service-card">
						<img src="/images/fachada.jpg" alt="Impermeabilización de fachadas">
						<h3>Impermeabilización de Fachadas</h3>
						<p>Protegemos las fachadas de su edificio contra la humedad y el desgaste.</p>
					</div>
					<div class="service-card">
						<img src="/images/tanque.jpg" alt="Impermeabilización de tanques">
						<h3>Impermeabilización de Tanques</h3>
						<p>Aseguramos que sus tanques de agua estén perfectamente sellados.</p>
					</div>
				</div>
			</div>
		</section>
	
		<!-- Projects Section -->
		<section class="projects" id="proyectos">
			<div class="container">
				<h2>PROYECTOS REALIZADOS</h2>
				<div class="projects-grid">
					<div class="project-card">
						<img src="/images/proyecto1.jpg" alt="Proyecto 1">
						<h3>Edificio Residencial</h3>
						<p>Impermeabilización de cubiertas y fachadas</p>
					</div>
					<div class="project-card">
						<img src="/images/proyecto2.jpg" alt="Proyecto 2">
						<h3>Conjunto Habitacional</h3>
						<p>Rehabilitación de terrazas y techos</p>
					</div>
					<div class="project-card">
						<img src="/images/proyecto3.jpg" alt="Proyecto 3">
						<h3>Centro Comercial</h3>
						<p>Impermeabilización de cubierta metálica</p>
					</div>
				</div>
			</div>
		</section>
	
		<!-- Call to Action -->
		<section class="cta">
			<div class="container">
				<h2>VISITA SIN COSTO EN TODAS LAS LOCALIDADES</h2>
				<p>Solicite una cotización sin compromiso</p>
				<a href="#contacto" class="cta-button">CONTÁCTENOS</a>
			</div>
		</section>
	
		<!-- Contact Section -->
		<section class="contact" id="contacto">
			<div class="container">
				<h2>CONTACTO</h2>
				<div class="contact-content">
					<div class="contact-info">
						<div class="contact-item">
							<i class="fas fa-phone"></i>
							<div>
								<h3>Teléfonos</h3>
								<p>3123091501</p>
								
							</div>
						</div>
						<div class="contact-item">
							<i class="fas fa-envelope"></i>
							<div>
								<h3>Email</h3>
								<p>info@impertech.com</p>
							</div>
						</div>
						<div class="contact-item">
							<i class="fas fa-map-marker-alt"></i>
							<div>
								<h3>Dirección</h3>
								<p>Calle Principal #123</p>
								<p>Ciudad</p>
							</div>
						</div>
					</div>
					<div class="contact-form">
						<form>
							<div class="form-group">
								<input type="text" placeholder="Nombre" required>
							</div>
							<div class="form-group">
								<input type="email" placeholder="Email" required>
							</div>
							<div class="form-group">
								<input type="tel" placeholder="Teléfono" required>
							</div>
							<div class="form-group">
								<textarea placeholder="Mensaje" rows="5" required></textarea>
							</div>
							<button type="submit" class="form-button">Enviar</button>
						</form>
					</div>
				</div>
			</div>
		</section>
	
		<!-- WhatsApp Button -->
		<a href="https://wa.me/3123091501" class="whatsapp-button" aria-label="WhatsApp">
			<i class="fab fa-whatsapp"></i>
		</a>
	
		<!-- Footer -->
		<footer class="footer">
			<div class="container">
				<div class="footer-content">
					<div class="footer-logo">
						<img src="/images/logo.png" alt="ImperTech Logo">
						<span>ImperTech</span>
					</div>
					<div class="footer-links">
						<ul>
							<li><a href="#inicio">Inicio</a></li>
							<li><a href="#servicios">Servicios</a></li>
							<li><a href="#proyectos">Proyectos</a></li>
							<li><a href="#quienes-somos">Quiénes Somos</a></li>
							<li><a href="#materiales">Materiales</a></li>
							<li><a href="#contacto">Contacto</a></li>
						</ul>
					</div>
					<div class="footer-social">
						<a href="#" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
						<a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
						<a href="#" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
					</div>
				</div>
				<div class="footer-bottom">
					<p>&copy; 2025 ImperTech. Todos los derechos reservados.</p>
				</div>
			</div>
		</footer>
	
		<style>
			/* Reset and base styles */
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}
	
			body {
				font-family: 'Arial', sans-serif;
				line-height: 1.6;
				color: #333;
			}
	
			.container {
				width: 90%;
				max-width: 1200px;
				margin: 0 auto;
			}
	
			a {
				text-decoration: none;
				color: inherit;
			}
	
			ul {
				list-style: none;
			}
	
			img {
				max-width: 100%;
				height: auto;
			}
	
			/* Header Styles */
			.header {
				background-color: #fff;
				box-shadow: 0 2px 5px rgba(0,0,0,0.1);
				padding: 1rem 0;
				position: fixed;
				width: 100%;
				top: 0;
				z-index: 1000;
			}
	
			.header .container {
				display: flex;
				justify-content: space-between;
				align-items: center;
			}
	
			.logo {
				display: flex;
				align-items: center;
				flex-direction: column;
			}
	
			.logo img {
				height: 50px;
			}
	
			.logo span {
				font-size: 1.5rem;
				font-weight: bold;
				color: #0074D9;
			}
	
			.logo p {
				font-size: 0.8rem;
				color: #777;
			}
	
			.main-nav ul {
				display: flex;
			}
	
			.main-nav li {
				margin: 0 1rem;
			}
	
			.main-nav a {
				color: #333;
				font-weight: bold;
				transition: color 0.3s;
			}
	
			.main-nav a:hover {
				color: #0074D9;
			}
	
			.social-icons a {
				margin-left: 1rem;
				font-size: 1.2rem;
				color: #0074D9;
			}
	
			/* Hero Section */
			.hero {
				background-image: url('/src/assets/background.jpg');
				background-size: cover;
				background-position: center;
				height: 100vh;
				display: flex;
				align-items: center;
				color: #fff;
				text-align: center;
				padding-top: 80px;
				position: relative;
			}
	
			.hero::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background-color: rgba(0,0,0,0.5);
			}
	
			.hero-content {
				position: relative;
				z-index: 1;
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem;
			}
	
			.hero h1 {
				font-size: 3rem;
				margin-bottom: 1rem;
			}
	
			.hero p {
				font-size: 1.2rem;
				margin-bottom: 2rem;
			}
	
			.contact-numbers {
				font-size: 1.5rem;
				font-weight: bold;
				margin-bottom: 2rem;
			}
	
			.contact-button {
				background-color: #0074D9;
				color: #fff;
				padding: 1rem 2rem;
				border-radius: 5px;
				font-weight: bold;
				transition: background-color 0.3s;
				display: inline-block;
			}
	
			.contact-button:hover {
				background-color: #0056b3;
			}
	
			/* Services Navigation */
			.services-nav {
				background-color: #0074D9;
				padding: 1rem 0;
			}
	
			.services-nav .container {
				display: flex;
				justify-content: space-between;
			}
	
			.service-link {
				color: #fff;
				font-weight: bold;
				padding: 0.5rem 1rem;
				transition: background-color 0.3s;
			}
	
			.service-link:hover {
				background-color: rgba(255,255,255,0.2);
			}
	
			/* About Section */
			.about {
				padding: 5rem 0;
				background-color: #f9f9
			}
	