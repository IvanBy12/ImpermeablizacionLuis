      { nombre: "Sika-1 - Impermeabilizante integral", url: "https://col.sika.com/dam/dms/co01/5/sika-1.pdf" }
    ]
  },{
    nombre: "Edil Colombia",
    imagen: "./src/assets/EdilLogo.png",
    descripcion: "Empresa colombiana que se dedica a la fabricación y venta de materiales para la impermeabilización.",
    productos: [
      { nombre: "Edil - Membrana asfáltica", url: "https://edil.com.co/producto/manto-poliester-20/" },
      { nombre: "Edil - Membrana líquida de poliuretano", url: "https://edil.com.co/producto/acrifilm-10/" },
      { nombre: "Edil - Impermeabilizante acrílico", url: "#" },
      { nombre: "Edil - Membrana de poliurea", url: "#" }
    ]
  },
  {
    nombre: "Texsa",
    imagen: "./src/assets/texsaLogo.png",
    descripcion: "Fabricante español de productos para la impermeabilización y aislamiento térmico.",
    productos: [
      { nombre: "TexsaPro - Membrana líquida de poliuretano", url: "https://texsa.com.co/dmdocuments/FTPCCW-525.pdf" },
      { nombre: "TexsaFibra - Impermeabilizante acrílico", url: "https://texsa.com.co/wp-content/uploads/2023/07/IMPERTEXSA.pdf" },
      { nombre: "TexsaTec - Membrana asfáltica", url: "https://texsa.com.co/wp-content/uploads/2023/02/TELA-ASFALTICA-TEXSA.pdf" },
      { nombre: "TexsaPur - Impermeabilizante de poliuretano", url: "https://texsa.com.co/dmdocuments/FTP%20MANTO%20IMPERMEABILIZANTE%20HIPERMANTO%20%20AL%20-%20PD_18.pdf" }
    ]
  },
  {
    nombre: "Placco Impermeablizantes",
    imagen: "./src/assets/placcoLogo.jpg",
    descripcion: "Empresa argentina con más de 30 años de experiencia en la fabricación de impermeabilizantes.",
    productos: [
      { nombre: "Placco - Membrana asfáltica", url: "#" },
      { nombre: "Placco - Membrana líquida de poliuretano", url: "#" },
      { nombre: "Placco - Impermeabilizante acrílico", url: "#" },
      { nombre: "Placco - Membrana de poliurea", url: "#" }
    ]
  },{
    nombre: "Mapei",
    imagen: "./src/assets/mapeiLogo.png",
    descripcion: "Compañía italiana con soluciones avanzadas de impermeabilización.",
    productos: [
      { nombre: "Mapelastic - Membrana cementosa flexible", url: "#" },
      { nombre: "Aquaflex - Membrana líquida elástica", url: "#" },
      { nombre: "Idrosilex - Impermeabilizante por cristalización", url: "#" },
      { nombre: "Purtop - Membrana de poliurea", url: "#" }
    ]
