  {
    nombre: "FiberGlass Colombia",
    imagen: "./src/assets/fiberglassLogo.png",
    descripcion: "Líder en Aislamientos térmicos y acústicos e impermeabilización con más de 60 años en el mercado Colombiano.",
    productos: [
      { nombre: "FiberGlass - Membrana asfáltica", url: "https://www.isover.com.co/documents/ficha-tecnica/ft-durafelt-es.pdf" },
      { nombre: "FiberGlass - Membrana líquida de poliuretano", url: "https://www.pinturasproa.com/es/documento/1508" },
      { nombre: "FiberGlass - Impermeabilizante acrílico", url: "https://www.isover.com.co/documents/product-datasheet/ficha-tecnica-manto-protektor-pro-es.pdf" },
      { nombre: "FiberGlass - Membrana de poliurea", url: "https://col.sika.com/dam/dms/co01/y/sikalastic-859-rultimate.pdf" }
    ]
  },
  {
    nombre: "Sika",
    imagen: "./src/assets/sikaLogo.png",
    descripcion: "Empresa suiza especializada en productos químicos para la construcción e impermeabilización.",
    productos: [
      { nombre: "Sikalastic - Membrana líquida de poliuretano", url: "https://col.sika.com/dam/dms/co01/x/sikalastic_-612_co.pdf" },
      { nombre: "SikaFill - Impermeabilizante elástico", url: "https://col.sika.com/dam/dms/co01/d/sikafill_-12_power.pdf" },
